{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickOrtho",
  "version": "0.2.0",
  "identifier": "io.github.seaviewer91.quickortho",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QuickOrtho",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Offline drone orthomosaic generator for field laptops",
    "category": "Utility",
    "copyright": "Copyright (c) 2026 Suho Bak. MIT License."
  }
}
